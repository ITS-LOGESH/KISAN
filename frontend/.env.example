# KrishiNet Frontend Environment Configuration
# Local development default:
VITE_API_URL=http://127.0.0.1:8000/api

# For production deployment on Vercel:
# Set VITE_API_URL in the Vercel project environment variables to the deployed Render backend URL ending in /api
# Example: VITE_API_URL=https://kisan-backend.onrender.com/api
