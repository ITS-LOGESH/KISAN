# KrishiNet Environment Configuration
# ₹0 Cost Setup - No Paid APIs Required

# Gemini API Key (Optional free tier key from Google AI Studio - https://aistudio.google.com/)
# If empty, transparent deterministic agricultural rules are used.
GEMINI_API_KEY=

# Open-Meteo Configuration (Free non-commercial public API, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Database Configuration (SQLite zero-cost local database, SQLAlchemy compatible with PostgreSQL)
DATABASE_URL=sqlite:///./krishinet.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Satellite Earth Engine Provider (disabled by default, ₹0 public dataset provider active)
ENABLE_EARTH_ENGINE=false
